# OpenAI API Key (for Agent A)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (for Agent B)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Simulation Mode: if set to true (or if keys are missing), runs intelligent local simulation
# Set to false to force real API calls when keys are provided
SIMULATION_MODE=true

# Model Configurations
AGENT_A_MODEL=gpt-4o-mini
AGENT_B_MODEL=claude-3-5-sonnet-20241022
AGENT_C_MODEL=supervisor-engine

# Quality acceptance threshold (0-100 score from Agent B)
QUALITY_THRESHOLD=80
