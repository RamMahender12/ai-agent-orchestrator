# OpenRouter. Agent A is Laguna S 2.1 free, Agent B is Nemotron 3 Ultra free.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenCode Zen key (optional; used only when OPENROUTER_API_KEY is empty)
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# OpenAI API Key (optional; used only when OPENCODE_API_KEY is empty)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (for Agent B)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Simulation Mode: if set to true (or if keys are missing), runs intelligent local simulation
# Set to false to force real API calls when keys are provided
SIMULATION_MODE=false

# Model Configurations
AGENT_A_MODEL=poolside/laguna-s-2.1:free
AGENT_B_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AGENT_C_MODEL=captain-engine

# Free OpenRouter models that answer alongside A and B (agents D to M). No fallback: a failure is logged against that agent.
AGENT_D_MODEL=recursive/flint-v1.0:free
AGENT_E_MODEL=xingchen-agi/xing4.0-29b-a4b:free
AGENT_F_MODEL=dots-studio/dots-3-note-preview:free
AGENT_G_MODEL=nvidia/nemotron-3.5-lightning:free
AGENT_H_MODEL=poolside/laguna-xs-2.1:free
AGENT_I_MODEL=google/gemma-4-31b-it:free
AGENT_J_MODEL=cohere/north-mini-code:free
AGENT_K_MODEL=nvidia/nemotron-3.5-super-vl:free
AGENT_L_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AGENT_M_MODEL=google/gemma-4-26b-a4b-it:free
